# Phase 2: Upstash Redis Credentials
# Copy this file to .env and fill in your actual credentials

# Redis REST API credentials from Upstash
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Phase 3: LLM API Keys
# Mistral AI API Key (via api.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Phase 4: Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Cloudflare R2 Storage (Zero-Egress CDN)
R2_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=manim-ai-videos
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
